# Parámetros NO secretos de las Cloud Functions (firebase functions:params).
# Copia este archivo a functions/.env y ajusta. El API key NO va aquí:
#   firebase functions:secrets:set AZURE_OPENAI_API_KEY

# Modelo de Azure OpenAI a usar (deployment en Foundry "Raiz-lifeplants").
AZURE_MODEL=gpt-5-mini

# Instancias mínimas para mitigar cold start (0 = sin costo en reposo).
CHAT_MIN_INSTANCES=0

# monitor → valida y registra; enforce → rechaza tokens ausentes/inválidos.
APP_CHECK_MODE=monitor

# Lista exacta, separada por comas. Requests móviles sin Origin siguen válidos.
ALLOWED_ORIGINS=http://localhost:8081,https://xsui.web.app,https://xsui.firebaseapp.com

# Todos los Client IDs usados por Android, iOS y web.
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Configurar fuera del archivo:
# firebase functions:secrets:set GOOGLE_OAUTH_WEB_CLIENT_SECRET
