{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "test/**/*.mjs"],
  "project": ["scripts/*.mjs", "test/**/*.mjs"],
  "ignore": [
    "apps/mobile/src/features/home/components/NightlyReportModal.tsx",
    "apps/functions/src/productivity/inMemorySyncProvider.ts",
    "apps/mobile/src/features/settings/connectionRegistry.ts",
    "apps/mobile/src/features/tasks/hooks/useGoogleTasks.ts",
    "apps/mobile/src/features/tasks/public.ts",
    "apps/mobile/src/features/tasks/services/tasksAuth.ts"
  ],
  "ignoreDependencies": [
    "@react-native/jest-preset",
    "@testing-library/react-native",
    "expo-secure-store",
    "expo-updates",
    "react-test-renderer"
  ],
  "workspaces": {
    "apps/mobile": {
      "entry": ["index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@react-native/jest-preset",
        "@testing-library/react-native",
        "expo-secure-store",
        "expo-updates",
        "react-test-renderer"
      ]
    },
    "apps/functions": {
      "entry": ["src/index.ts", "test/**/*.js", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.js", "scripts/*.mjs"],
      "ignoreDependencies": ["@sui/contracts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
