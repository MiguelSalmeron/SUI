{
  "name": "sui",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13 <25"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@sentry/react-native": "~7.11.0",
    "ci-audit": "^1.2.1",
    "expo": "~57.0.18",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.10",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.28.2",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "architecture": "node scripts/check-architecture.mjs",
    "architecture:test": "node --test scripts/check-architecture.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:changed": "node scripts/check-format-changed.mjs",
    "dead-code": "knip --include files,dependencies,unlisted --reporter compact",
    "deps:check": "expo install --check",
    "audit:prod": "npm audit --omit=dev --audit-level=high && npm --prefix functions audit --omit=dev --audit-level=high",
    "check:production": "node scripts/check-production-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:sync": "npm --prefix functions run build && node --test functions/test/productivitySync.emulator.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project sui-rules-test \"node --test test/firestore.rules.test.mjs && npm run test:sync\"",
    "check": "npm run architecture && npm run architecture:test && npm run lint && npm run dead-code && npm run deps:check && npm run check:production && npm run typecheck && npm run test && npm run functions:test && npm run test:rules",
    "eas-build-pre-install": "node scripts/check-production-config.mjs"
  },
  "private": true
}
