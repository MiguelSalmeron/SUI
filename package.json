{
  "name": "sui-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "start": "npm run start --workspace @sui/mobile",
    "android": "npm run android --workspace @sui/mobile",
    "ios": "npm run ios --workspace @sui/mobile",
    "web": "npm run web --workspace @sui/mobile",
    "export:web": "npm run export:web --workspace @sui/mobile",
    "architecture": "node scripts/check-architecture.mjs",
    "architecture:test": "node --test scripts/check-architecture.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:changed": "node scripts/check-format-changed.mjs",
    "dead-code": "knip --include files,dependencies,unlisted --reporter compact",
    "deps:check": "npm run deps:check --workspace @sui/mobile",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:production": "node scripts/check-production-config.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:mobile": "npm run test --workspace @sui/mobile",
    "functions:build": "npm run build --workspace @sui/functions",
    "functions:test": "npm run test --workspace @sui/functions",
    "test:sync": "npm run functions:build && node --test apps/functions/test/productivitySync.emulator.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project sui-rules-test \"node --test test/firestore.rules.test.mjs && npm run test:sync\"",
    "check": "npm run architecture && npm run architecture:test && npm run lint && npm run dead-code && npm run deps:check && npm run check:production && npm run typecheck && npm run test && npm run test:rules",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.28.2",
    "globals": "^17.11.0",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.6",
    "typescript": "~6.0.3"
  }
}
