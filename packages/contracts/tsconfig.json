{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2021",
    "lib": ["es2021"],
    "moduleResolution": "Node16",
    "declaration": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
