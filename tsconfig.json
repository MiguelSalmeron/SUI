{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["jest", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["App.tsx", "src/**/*", "index.ts"],
  "exclude": ["functions", "node_modules", "dist"]
}
